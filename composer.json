{
    "name": "jeffersongoncalves/laravel-posthog",
    "description": "PHP/Laravel client for the PostHog API: event capture, batch ingestion, feature flags, persons and HogQL queries.",
    "keywords": [
        "laravel",
        "posthog",
        "analytics",
        "feature-flags",
        "hogql",
        "api"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-posthog",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7.4|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\PostHog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\PostHog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\PostHog\\PostHogServiceProvider"
            ],
            "aliases": {
                "PostHog": "JeffersonGoncalves\\PostHog\\Facades\\PostHog"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
